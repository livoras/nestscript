#!/usr/bin/env node

'use strict'

const fs = require('fs')
const path = require('path')
const {
  createVMFromArrayBuffer,
  generateAssemblyFromJs,
  parseCodeToProgram,
} = require('../../build/src')
const packageJson = require('../../package.json')

const usage = `NestScript ${packageJson.version}

Usage:
  nsc compile <source.js> <output>
  nsc codegen <source.js> <output.nes>
  nsc run <bytecode>

Commands:
  compile  Compile JavaScript directly to NestScript bytecode
  codegen  Generate human-readable NestScript assembly
  run      Execute NestScript bytecode with a Node.js host context

Options:
  -h, --help     Show this help
  -v, --version  Show the installed version`

const resolvePath = (file) => path.resolve(process.cwd(), file)

const requireArguments = (command, args, count) => {
  if (args.length !== count) {
    throw new Error(`Invalid arguments for '${command}'. Run 'nsc --help' for usage.`)
  }
}

const createNodeContext = () => ({
  Array,
  ArrayBuffer,
  Boolean,
  Buffer,
  DataView,
  Date,
  Error,
  Function,
  Infinity,
  Map,
  Math,
  Number,
  Object,
  RegExp,
  Set,
  String,
  TypeError,
  Uint8Array,
  console,
  process,
})

const compile = (sourceFile, outputFile) => {
  const source = fs.readFileSync(resolvePath(sourceFile), 'utf8')
  const assembly = generateAssemblyFromJs(source)
  fs.writeFileSync(resolvePath(outputFile), parseCodeToProgram(assembly))
  console.log('Compile done!')
}

const codegen = (sourceFile, outputFile) => {
  const source = fs.readFileSync(resolvePath(sourceFile), 'utf8')
  fs.writeFileSync(resolvePath(outputFile), generateAssemblyFromJs(source))
  console.log('Code generation done!')
}

const run = (bytecodeFile) => {
  const file = fs.readFileSync(resolvePath(bytecodeFile))
  const bytecode = Uint8Array.from(file).buffer
  const vm = createVMFromArrayBuffer(bytecode, createNodeContext())
  vm.run()
}

const main = () => {
  const [command, ...args] = process.argv.slice(2)

  if (!command || command === '-h' || command === '--help' || command === 'help') {
    console.log(usage)
    return
  }
  if (command === '-v' || command === '--version' || command === 'version') {
    console.log(packageJson.version)
    return
  }

  switch (command) {
    case 'compile':
      requireArguments(command, args, 2)
      compile(args[0], args[1])
      return
    case 'codegen':
      requireArguments(command, args, 2)
      codegen(args[0], args[1])
      return
    case 'run':
      requireArguments(command, args, 1)
      run(args[0])
      return
    default:
      throw new Error(`Unknown command '${command}'. Run 'nsc --help' for usage.`)
  }
}

try {
  main()
} catch (error) {
  console.error(error && error.stack ? error.stack : error)
  process.exitCode = 1
}
